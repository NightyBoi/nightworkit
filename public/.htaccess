# Angular HTML5 routing fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache headers
<IfModule mod_expires.c>
  ExpiresActive On

  # index.html — always revalidate so deploys are picked up immediately
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>

  # Hashed JS/CSS bundles — 1 year, immutable (hash changes on every deploy)
  <FilesMatch "\.[0-9A-Z]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Fonts — 1 year (never change)
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Images — 30 days
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # Manifest / robots / sitemap — 1 day
  <FilesMatch "\.(json|txt|xml)$">
    Header set Cache-Control "public, max-age=86400"
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>

# Compression (LiteSpeed usually handles this, but fallback for Apache)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
